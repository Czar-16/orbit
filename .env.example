ORBIT_MODE=local
# Run npm run db:setup to generate ignored local database credentials.
# DATABASE_URL must target a loopback PostgreSQL server, with no query parameters.

# Optional preparation AI: default off. Never needed for matching or preparation.
# Explicitly choose an available model; no hosted call without paid opt-in.
# OPENAI_API_KEY=
# OPENAI_MODEL=
ORBIT_ALLOW_PAID_AI=false
# Local Ollama fixed endpoint: http://127.0.0.1:11434/api/generate
# OLLAMA_MODEL=
