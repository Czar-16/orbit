generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum SourceKind {
  MANUAL
  OFFICIAL_API
}
enum PolicyDecision {
  NOT_REVIEWED
  ALLOWED
  BLOCKED
}
enum IntakeMethod {
  PASTED_URL
  PASTED_DESCRIPTION
  IMPORTED_FILE
  PERMITTED_API
}
model Workspace {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  timezone String @default("Asia/Kolkata")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  resumes ResumeVersion[]
  profiles ProfileVersion[]
  sources Source[]
  jobs Job[]
  revisions JobRevision[]
  matches MatchResult[]
  preferences PreferenceVersion[]
  weightedMatches WeightedMatch[]
  discoveryRuns DiscoveryRun[]
  drafts ApplicationDraft[]
  outboundLogs OutboundDataLog[]
}
model ResumeVersion {
  drafts ApplicationDraft[]
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  roleCategory String?
  isDefault Boolean @default(false)
  storageKey String @unique
  filename String
  mimeType String
  byteSize Int
  sha256 String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  profiles ProfileVersion[]
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}
model ProfileVersion {
  drafts ApplicationDraft[]
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  revision Int
  schemaVersion Int @default(1)
  facts Json @db.JsonB
  resumeVersionId String? @db.Uuid
  matches MatchResult[]
  weightedMatches WeightedMatch[]
  resume ResumeVersion? @relation(fields: [workspaceId, resumeVersionId], references: [workspaceId, id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([workspaceId, revision])
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}
model Source {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  identity String
  label String
  kind SourceKind @default(MANUAL)
  endpoint String?
  termsUrl String?
  reviewedAt DateTime? @db.Timestamptz(3)
  decision PolicyDecision @default(NOT_REVIEWED)
  enabled Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  jobs Job[]
  provider String?
  companyQuery String?
  removedAt DateTime? @db.Timestamptz(3)
  runs DiscoveryRun[]
  @@unique([workspaceId, identity])
  @@unique([workspaceId, id])
}
model Job {
  drafts ApplicationDraft[]
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceId String @db.Uuid
  source Source @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Restrict)
  externalId String?
  listingUrl String?
  urlHash String?
  processedRelevant Boolean @default(false)
  discoveredAt DateTime @default(now()) @db.Timestamptz(3)
  savedAt DateTime? @db.Timestamptz(3)
  dismissedAt DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  latestRevisionNumber Int?
  latestRevision JobRevision? @relation("LatestRevision", fields: [workspaceId, id, latestRevisionNumber], references: [workspaceId, jobId, revision], onDelete: Restrict, onUpdate: NoAction)
  revisions JobRevision[] @relation("JobHistory")
  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceId, externalId])
  @@unique([workspaceId, urlHash])
  @@index([workspaceId, discoveredAt])
  @@index([workspaceId, savedAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, sourceId])
}
model JobRevision {
  drafts ApplicationDraft[]
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  jobId String @db.Uuid
  job Job @relation("JobHistory", fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Restrict)
  matches MatchResult[]
  weightedMatches WeightedMatch[]
  latestFor Job[] @relation("LatestRevision")
  revision Int
  schemaVersion Int @default(2)
  listingUrl String?
  sourceSnapshot Json? @db.JsonB
  description String?
  contentHash String
  capturedAt DateTime @default(now()) @db.Timestamptz(3)
  method IntakeMethod
  title String?
  company String?
  location String?
  workArrangement String?
  employmentType String?
  compensationMin Decimal? @db.Decimal(14,2)
  compensationMax Decimal? @db.Decimal(14,2)
  currency String?
  compensationPeriod String?
  experienceRequirement String?
  skills String[]
  provenance Json @db.JsonB
  @@unique([workspaceId, jobId, revision])
  @@unique([workspaceId, id])
  @@unique([workspaceId, jobId, id])
  @@index([workspaceId, title])
  @@index([workspaceId, company])
  @@index([workspaceId, location])
  @@index([workspaceId, workArrangement])
}

model MatchResult {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  jobRevisionId String @db.Uuid
  jobRevision JobRevision @relation(fields: [workspaceId, jobRevisionId], references: [workspaceId, id], onDelete: Restrict)
  profileVersionId String @db.Uuid
  profileVersion ProfileVersion @relation(fields: [workspaceId, profileVersionId], references: [workspaceId, id], onDelete: Restrict)
  ruleVersion String
  score Int?
  explanation Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([workspaceId, jobRevisionId, profileVersionId, ruleVersion])
  @@index([workspaceId, createdAt])
}

model PreferenceVersion {
  origin String @default("user")
  drafts ApplicationDraft[]
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  revision Int
  values Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  matches WeightedMatch[]
  @@unique([workspaceId, revision])
  @@unique([workspaceId, id])
}
model WeightedMatch {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  jobRevisionId String @db.Uuid
  jobRevision JobRevision @relation(fields: [workspaceId, jobRevisionId], references: [workspaceId, id], onDelete: Restrict)
  profileVersionId String @db.Uuid
  profileVersion ProfileVersion @relation(fields: [workspaceId, profileVersionId], references: [workspaceId, id], onDelete: Restrict)
  preferenceVersionId String @db.Uuid
  preferenceVersion PreferenceVersion @relation(fields: [workspaceId, preferenceVersionId], references: [workspaceId, id], onDelete: Restrict)
  ruleVersion String
  score Int?
  explanation Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([workspaceId, jobRevisionId, profileVersionId, preferenceVersionId, ruleVersion])
  @@index([workspaceId, createdAt])
}

model DiscoveryRun {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceId String @db.Uuid
  source Source @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Restrict)
  provider String
  day String @db.VarChar(10)
  state String
  fetched Int @default(0)
  imported Int @default(0)
  duplicates Int @default(0)
  error String?
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  @@unique([workspaceId, sourceId, day])
  @@index([workspaceId, provider, day])
}

model ApplicationDraft {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  jobId String @db.Uuid
  job Job @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Restrict)
  jobRevisionId String @db.Uuid
  jobRevision JobRevision @relation(fields: [workspaceId, jobId, jobRevisionId], references: [workspaceId, jobId, id], onDelete: Restrict)
  profileVersionId String @db.Uuid
  profile ProfileVersion @relation(fields: [workspaceId, profileVersionId], references: [workspaceId, id], onDelete: Restrict)
  preferenceVersionId String @db.Uuid
  preference PreferenceVersion @relation(fields: [workspaceId, preferenceVersionId], references: [workspaceId, id], onDelete: Restrict)
  resumeVersionId String @db.Uuid
  resume ResumeVersion @relation(fields: [workspaceId, resumeVersionId], references: [workspaceId, id], onDelete: Restrict)
  revision Int
  operation String
  content Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([workspaceId, jobId, revision])
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}
model OutboundDataLog {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  feature String
  provider String
  model String
  fields String[]
  result String @default("attempted")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  @@index([workspaceId, createdAt])
}
